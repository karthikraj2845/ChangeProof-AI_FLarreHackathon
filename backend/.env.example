# Application settings
APP_NAME="ChangeProof AI"
APP_ENV="development"
DEBUG=true

# Database (defaults to local SQLite; can be switched to PostgreSQL)
DATABASE_URL="sqlite:///./changeproof.db"
# Example PostgreSQL: DATABASE_URL="postgresql://postgres:postgres@localhost:5432/changeproof_ai"

# AI Provider settings
# Leave empty to run with 100% deterministic, offline-capable heuristic AI mode!
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"
AI_PROVIDER="auto"
